<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accept Invitation - CRM</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-xl shadow-lg border border-gray-200 p-8">
    <div class="text-center mb-6">
      <span class="text-4xl text-indigo-600"><i class="fas fa-envelope-open-text"></i></span>
      <h1 class="mt-2 text-xl font-bold text-gray-900">Accept invitation</h1>
      <p class="text-sm text-gray-500 mt-1">Set your password to join the team</p>
    </div>
    <% if (typeof error === 'string' && error) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"><%= error %></div>
    <% } %>
    <% if (token) { %>
    <form action="/auth/accept-invite" method="POST" class="space-y-4">
      <%- include('partials/csrf-input') %>
      <input type="hidden" name="token" value="<%= token %>">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" value="<%= typeof email !== 'undefined' ? email : '' %>" disabled class="w-full px-3 py-2 border border-gray-200 rounded-md bg-gray-50 text-gray-600">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Your name</label>
        <input type="text" name="name" placeholder="Your name" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Temporary password</label>
        <input type="password" name="tempPassword" required placeholder="From invitation email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">New password</label>
        <input type="password" name="newPassword" required minlength="6" placeholder="At least 6 characters" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm new password</label>
        <input type="password" name="confirmNewPassword" required minlength="6" placeholder="Repeat new password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
      </div>
      <button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 font-medium">
        Create account & sign in
      </button>
    </form>
    <% } else { %>
    <a href="/auth/login" class="block text-center py-2 text-indigo-600 hover:text-indigo-700 font-medium">Back to login</a>
    <% } %>
  </div>
</body>
</html>
