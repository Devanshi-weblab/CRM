<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .sidebar-link.active {
      background-color: #EEF2FF;
      color: #4F46E5;
    }
    .mobile-menu {
      transition: transform 0.3s ease-in-out;
    }
    .mobile-menu.hidden {
      transform: translateX(-100%);
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/sidebar-toggle') %>
  <main class="flex-1 main-content min-h-screen md:ml-64 pt-24 md:pt-8 p-4 md:p-8">
      <div class="space-y-6">
        <!-- Welcome Section -->
        <div class="bg-white rounded-lg shadow p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
              <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Welcome back, <%= user ? user.name : '' %></h1>
              <p class="text-gray-600">Company: <%= user ? user.companyName : '' %></p>
              <p class="text-sm text-gray-500 mt-2">Last login: <%= new Date().toLocaleDateString() %></p>
            </div>
            <div class="mt-6 md:mt-0 flex flex-wrap gap-3">
              <a href="/clients" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition">
                <i class="fas fa-users mr-2"></i> Manage Clients
              </a>
              <a href="/employees/invite" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-md shadow hover:bg-green-700 transition">
                <i class="fas fa-envelope mr-2"></i> Invite Employee
              </a>
            </div>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-indigo-100 text-indigo-600">
                <i class="fas fa-users text-xl"></i>
              </div>
              <div class="ml-4">
                <h2 class="text-gray-600 text-sm">Total Clients</h2>
                <p class="text-2xl font-semibold text-gray-900"><%= typeof totalClients !== 'undefined' ? totalClients : 0 %></p>
                <p class="text-xs text-gray-500 mt-1">Active accounts</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-green-100 text-green-600">
                <i class="fas fa-user-tie text-xl"></i>
              </div>
              <div class="ml-4">
                <h2 class="text-gray-600 text-sm">Total Employees</h2>
                <p class="text-2xl font-semibold text-gray-900"><%= typeof totalEmployees !== 'undefined' ? totalEmployees : 0 %></p>
                <p class="text-xs text-gray-500 mt-1">Team members</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-blue-100 text-blue-600">
                <i class="fas fa-chart-line text-xl"></i>
              </div>
              <div class="ml-4">
                <h2 class="text-gray-600 text-sm">Active Projects</h2>
                <p class="text-2xl font-semibold text-gray-900">0</p>
                <p class="text-xs text-gray-500 mt-1">In progress</p>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="p-3 rounded-full bg-purple-100 text-purple-600">
                <i class="fas fa-clock text-xl"></i>
              </div>
              <div class="ml-4">
                <h2 class="text-gray-600 text-sm">Today's Logins</h2>
                <p class="text-2xl font-semibold text-gray-900">0</p>
                <p class="text-xs text-gray-500 mt-1">Last 24 hours</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Client Status Breakdown -->
        <% if (typeof statusOptions !== 'undefined') { %>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Client status</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-gray-50 rounded-lg p-4 border-l-4 border-gray-500">
              <p class="text-sm font-medium text-gray-600">No Status</p>
              <p class="text-2xl font-semibold text-gray-900"><%= typeof statusCounts !== 'undefined' && statusCounts.noStatus !== undefined ? statusCounts.noStatus : 0 %></p>
            </div>
            <% if (typeof statusOptions !== 'undefined') { statusOptions.forEach(function(option) { %>
            <div class="bg-indigo-50 rounded-lg p-4 border-l-4 border-indigo-500">
              <p class="text-sm font-medium text-gray-600"><%= option.name %></p>
              <p class="text-2xl font-semibold text-gray-900"><%= typeof statusCounts !== 'undefined' && statusCounts[option._id.toString()] !== undefined ? statusCounts[option._id.toString()] : 0 %></p>
            </div>
            <% }); } %>
          </div>
        </div>
        <% } %>

        <!-- Recent Activity -->
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">Recent Activity</h2>
            <a href="/clients" class="text-sm text-indigo-600 hover:text-indigo-700">View clients</a>
          </div>
          <div class="space-y-3">
            <% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
              <% recentActivity.forEach(function(item) { %>
              <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                <div class="p-2 rounded-full <%= item.type === 'client' ? 'bg-green-100 text-green-600' : item.type === 'activity' ? 'bg-blue-100 text-blue-600' : 'bg-purple-100 text-purple-600' %>">
                  <i class="fas <%= item.type === 'client' ? 'fa-user-plus' : item.type === 'activity' ? 'fa-sticky-note' : 'fa-sign-in-alt' %>"></i>
                </div>
                <div class="ml-4 flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate"><%= item.text %></p>
                  <p class="text-xs text-gray-500"><%= item.by ? 'By ' + item.by + ' · ' : '' %><%= item.date ? new Date(item.date).toLocaleString() : '' %></p>
                </div>
                <% if (item.link) { %><a href="<%= item.link %>" class="text-indigo-600 text-sm hover:text-indigo-700 flex-shrink-0">View</a><% } %>
              </div>
              <% }); %>
            <% } else { %>
              <p class="text-sm text-gray-500">No recent activity yet.</p>
            <% } %>
          </div>
        </div>

        <!-- Tasks: Due today / Overdue -->
        <% if (typeof overdueTasks !== 'undefined' || typeof dueTodayTasks !== 'undefined') { %>
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Follow-ups & tasks</h2>
          <% if (overdueTasks && overdueTasks.length > 0) { %>
          <div class="mb-4">
            <h3 class="text-sm font-medium text-red-700 mb-2">Overdue</h3>
            <ul class="space-y-2">
              <% overdueTasks.forEach(function(t) { %>
              <li class="flex items-center justify-between p-2 bg-red-50 rounded">
                <span class="text-sm"><%= t.title %> — <%= t.clientId ? t.clientId.name : 'Client' %></span>
                <a href="/clients/<%= t.clientId && t.clientId._id %>" class="text-indigo-600 text-xs">View</a>
              </li>
              <% }); %>
            </ul>
          </div>
          <% } %>
          <% if (dueTodayTasks && dueTodayTasks.length > 0) { %>
          <div>
            <h3 class="text-sm font-medium text-gray-700 mb-2">Due today</h3>
            <ul class="space-y-2">
              <% dueTodayTasks.forEach(function(t) { %>
              <li class="flex items-center justify-between p-2 bg-gray-50 rounded">
                <span class="text-sm"><%= t.title %> — <%= t.clientId ? t.clientId.name : 'Client' %></span>
                <a href="/clients/<%= t.clientId && t.clientId._id %>" class="text-indigo-600 text-xs">View</a>
              </li>
              <% }); %>
            </ul>
          </div>
          <% } %>
          <% if ((!overdueTasks || overdueTasks.length === 0) && (!dueTodayTasks || dueTodayTasks.length === 0)) { %>
          <p class="text-sm text-gray-500">No tasks due today or overdue. Add follow-ups from client pages.</p>
          <% } %>
        </div>
        <% } %>

        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <a href="/clients" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors group">
              <div class="p-3 rounded-full bg-indigo-100 text-indigo-600 group-hover:bg-indigo-200">
                <i class="fas fa-users"></i>
              </div>
              <div class="ml-4">
                <span class="font-medium text-gray-900">Manage Clients</span>
                <p class="text-sm text-gray-500">View and edit client information</p>
              </div>
            </a>
            <a href="/employees" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors group">
              <div class="p-3 rounded-full bg-green-100 text-green-600 group-hover:bg-green-200">
                <i class="fas fa-user-tie"></i>
              </div>
              <div class="ml-4">
                <span class="font-medium text-gray-900">Manage Employees</span>
                <p class="text-sm text-gray-500">View and manage team members</p>
              </div>
            </a>
            <a href="/employees/invite" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors group">
              <div class="p-3 rounded-full bg-blue-100 text-blue-600 group-hover:bg-blue-200">
                <i class="fas fa-envelope"></i>
              </div>
              <div class="ml-4">
                <span class="font-medium text-gray-900">Invite Employee</span>
                <p class="text-sm text-gray-500">Send invitation by email</p>
              </div>
            </a>
            <a href="/admin/status-options" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors group">
              <div class="p-3 rounded-full bg-purple-100 text-purple-600 group-hover:bg-purple-200">
                <i class="fas fa-tags"></i>
              </div>
              <div class="ml-4">
                <span class="font-medium text-gray-900">Manage Status</span>
                <p class="text-sm text-gray-500">Configure status options</p>
              </div>
            </a>
          </div>
        </div>
      </div>
  </main>

  <%- include('../partials/footer') %>

  <script>
    // Function to check if the context is secure
    function isSecureContext() {
      return window.isSecureContext || window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    }

    // Function to get user's location
    function getLocation() {
      // Skip location tracking if not in secure context
      if (!isSecureContext()) {
        console.log('Skipping location tracking - not in secure context');
        return;
      }

      if (!navigator.geolocation) {
        console.error('Geolocation is not supported by your browser');
        return;
      }

      const options = {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 0
      };

      navigator.geolocation.getCurrentPosition(
        // Success callback
        async (position) => {
          const { latitude, longitude } = position.coords;
          
          try {
            const response = await fetch('/auth/api/location-log', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                latitude,
                longitude,
                timestamp: new Date().toISOString()
              })
            });

            const data = await response.json();
            if (!data.success) {
              console.error('Failed to update location:', data.error);
            }
          } catch (err) {
            console.error('Error updating location:', err);
          }
        },
        // Error callback
        (error) => {
          console.error('Error getting location:', error);
        },
        options
      );
    }

    // Only try to get location if in secure context
    if (isSecureContext()) {
      document.addEventListener('DOMContentLoaded', getLocation);
    }
  </script>
</body>
</html>