<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Status Options</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .table-improved tbody tr:hover { background-color: rgba(238, 242, 255, 0.8); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/sidebar-toggle') %>
  <main class="flex-1 main-content min-h-screen md:ml-64 pt-24 md:pt-8 p-4 md:p-8 mt-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-8">
          <h1 class="text-2xl font-bold text-gray-900">Manage Status Options</h1>
          <button onclick="openAddModal()" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition">
            <i class="fas fa-plus mr-2"></i> Add Status
          </button>
        </div>

        <!-- Status Options Table -->
        <div class="bg-white rounded-lg shadow overflow-auto max-h-[70vh] table-scroll-wrap">
          <% if (statusOptions.length === 0) { %>
          <div class="empty-state text-center py-16 px-4">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
              <i class="fas fa-tags text-3xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No status options yet</h3>
            <p class="text-gray-500 mb-6 max-w-sm mx-auto">Add your first status (e.g. Active, Pending) to organize clients.</p>
            <button type="button" onclick="openAddModal()" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition">
              <i class="fas fa-plus mr-2"></i> Add Status
            </button>
          </div>
          <% } else { %>
          <table class="table-improved min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  <a href="/admin/status-options<%= typeof buildQuery === 'function' ? buildQuery({ sort: 'name', order: typeof sortBy !== 'undefined' && sortBy === 'name' && sortOrder === 'asc' ? 'desc' : 'asc' }) : '?sort=name&order=asc' %>" class="inline-flex items-center gap-1 group hover:text-indigo-600">
                    Name
                    <% if (typeof sortBy !== 'undefined' && sortBy === 'name') { %>
                      <i class="fas fa-sort-<%= sortOrder === 'asc' ? 'up' : 'down' %> text-indigo-600"></i>
                    <% } else { %>
                      <i class="fas fa-sort text-gray-400 group-hover:text-indigo-500"></i>
                    <% } %>
                  </a>
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created By</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% statusOptions.forEach((option, i) => { %>
                <tr class="<%= i % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> hover:bg-indigo-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 py-1 rounded text-sm bg-gray-100 text-gray-800">
                      <%= option.name %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-900"><%= option.createdBy?.name || 'Unknown' %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-900"><%= option.createdAt.toLocaleDateString() %></td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <button type="button" onclick="deleteStatusOption('<%= option._id %>')" class="inline-flex items-center justify-center w-8 h-8 rounded text-red-600 hover:bg-red-50 hover:text-red-800" title="Delete">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
  </main>

  <!-- Add Status Modal (z-50 so it appears above sticky table header) -->
  <div id="addStatusModal" class="fixed inset-0 z-50 bg-gray-600 bg-opacity-50 hidden overflow-y-auto h-full w-full">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white z-50">
      <div class="mt-3">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Add New Status</h3>
        <form id="addStatusForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status Name</label>
            <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div class="flex justify-end space-x-3">
            <button type="button" onclick="closeAddModal()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
              Add Status
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openAddModal() {
      document.getElementById('addStatusModal').classList.remove('hidden');
    }

    function closeAddModal() {
      document.getElementById('addStatusModal').classList.add('hidden');
    }

    document.getElementById('addStatusForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      
      try {
        const response = await fetch('/api/status-options', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            name: formData.get('name')
          })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to add status option');
        }
      } catch (err) {
        alert('An error occurred while adding the status option');
      }
    });

    async function deleteStatusOption(id) {
      if (!confirm('Are you sure you want to delete this status option?')) return;

      try {
        const response = await fetch(`/api/status-options/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to delete status option');
        }
      } catch (err) {
        alert('An error occurred while deleting the status option');
      }
    }
  </script>

  <%- include('../partials/footer') %>
</body>
</html> 