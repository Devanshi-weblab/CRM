<%- include('../partials/layout-start') %>
  <div class="max-w-4xl mx-auto">
    <div class="bg-white rounded-lg shadow p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
        <i class="fas fa-user-plus mr-2 text-yellow-500"></i> Add New Client
      </h2>
      <form action="/clients/add" method="POST" class="space-y-4" data-loading>
        <%- include('../partials/csrf-input') %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
            <input type="text" name="contactNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input name="email" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent" />
          </div>
          <div class="md:col-span-2 lg:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
            <textarea name="address" rows="2" placeholder="Enter complete address" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Meeting Date and Time</label>
            <input name="meetingDate" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select id="status" name="status" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent">
              <option value="">Select Status</option>
              <% statusOptions.forEach(function(option) { %>
                <option value="<%= option._id %>"><%= option.name %></option>
              <% }); %>
            </select>
          </div>
          <% if (typeof user !== 'undefined' && user.role === 'admin') { %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Assigned To</label>
            <select name="assignedTo" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent">
              <option value="">Unassigned</option>
              <% if (typeof employees !== 'undefined' && employees.length) { %>
                <% employees.forEach(function(emp) { %>
                  <option value="<%= emp._id %>"><%= emp.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <% } %>
          <div class="md:col-span-2 lg:col-span-3">
            <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
            <textarea name="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"></textarea>
          </div>
        </div>
        <input type="hidden" name="companyId" value="<%= companyId %>">
        <input type="hidden" name="addedBy" value="<%= addedBy %>">
        <div class="flex justify-end mt-6">
          <button class="inline-flex items-center px-4 py-2 bg-yellow-500 text-white rounded-md shadow hover:bg-yellow-600 transition">
            <i class="fas fa-save mr-2"></i> Add Client
          </button>
          <a href="/clients" class="inline-flex items-center px-4 py-2 ml-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition">
            <i class="fas fa-times mr-2"></i> Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
<%- include('../partials/layout-end') %>
