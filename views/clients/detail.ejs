<!DOCTYPE html>
<html lang="en">
<% var client = viewData.client, activities = viewData.activities, user = viewData.user; %>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Client - <%= client.name %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/sidebar-toggle') %>
  <main class="flex-1 main-content min-h-screen md:ml-64 pt-24 md:pt-8 p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <a href="/clients" class="text-sm text-indigo-600 hover:text-indigo-700 mb-2 inline-block"><i class="fas fa-arrow-left mr-1"></i> Back to clients</a>
          <h1 class="text-2xl font-bold text-gray-900"><%= client.name %></h1>
        </div>
        <a href="/clients/edit/<%= client._id %>" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
          <i class="fas fa-edit mr-2"></i> Edit
        </a>
      </div>

      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Details</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
          <div><dt class="text-gray-500">Contact</dt><dd class="font-medium"><%= client.contactNumber || '—' %></dd></div>
          <div><dt class="text-gray-500">Email</dt><dd class="font-medium"><%= client.email || '—' %></dd></div>
          <div class="md:col-span-2"><dt class="text-gray-500">Address</dt><dd class="font-medium"><%= client.address || '—' %></dd></div>
          <div><dt class="text-gray-500">Status</dt><dd><%= client.status ? client.status.name : '—' %></dd></div>
          <div><dt class="text-gray-500">Assigned to</dt><dd><%= client.assignedTo ? client.assignedTo.name : '—' %></dd></div>
          <div><dt class="text-gray-500">Meeting date</dt><dd><%= client.meetingDate ? new Date(client.meetingDate).toLocaleString() : '—' %></dd></div>
          <div class="md:col-span-2"><dt class="text-gray-500">Notes</dt><dd class="font-medium"><%= client.notes || '—' %></dd></div>
        </dl>
      </div>

      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Follow-up tasks</h2>
        <form id="addTaskForm" class="mb-4 p-4 bg-gray-50 rounded-lg flex flex-wrap gap-3 items-end">
          <input type="hidden" name="clientId" value="<%= client._id %>">
          <div class="flex-1 min-w-[160px]">
            <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
            <input type="text" name="title" required placeholder="e.g. Call back" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500">
          </div>
          <div class="min-w-[160px]">
            <label class="block text-sm font-medium text-gray-700 mb-1">Due date</label>
            <input type="datetime-local" name="dueDate" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500">
          </div>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Add task</button>
        </form>
        <ul id="taskList" class="space-y-2"></ul>
        <p id="taskListEmpty" class="text-sm text-gray-500">Loading tasks…</p>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Activity timeline</h2>
        <form id="addActivityForm" class="mb-6 p-4 bg-gray-50 rounded-lg">
          <div class="flex flex-wrap gap-3 items-end">
            <div class="flex-1 min-w-[200px]">
              <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
              <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500">
                <option value="note">Note</option>
                <option value="call">Call</option>
                <option value="meeting">Meeting</option>
              </select>
            </div>
            <div class="flex-1 min-w-[200px]">
              <label class="block text-sm font-medium text-gray-700 mb-1">Content</label>
              <input type="text" name="content" required placeholder="Add a note..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500">
            </div>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Add</button>
          </div>
        </form>
        <ul id="activityList" class="space-y-4">
          <% activities.forEach(function(a) { %>
          <li class="flex gap-3 border-l-2 border-indigo-200 pl-4 py-2">
            <span class="text-xs text-gray-500 whitespace-nowrap"><%= new Date(a.createdAt).toLocaleString() %></span>
            <span class="px-2 py-0.5 rounded text-xs font-medium <%= a.type === 'meeting' ? 'bg-blue-100 text-blue-800' : a.type === 'call' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>"><%= a.type %></span>
            <span class="text-gray-700"><%= a.content %></span>
            <span class="text-gray-500 text-sm">— <%= a.userId ? a.userId.name : 'Unknown' %></span>
          </li>
          <% }); %>
          <% if (activities.length === 0) { %>
          <li id="activityEmpty" class="text-gray-500 text-sm">No activities yet. Add a note, call, or meeting above.</li>
          <% } %>
        </ul>
      </div>
    </div>
  </main>
  <script>
    (function() {
      const clientId = '<%= client._id %>';
      const taskList = document.getElementById('taskList');
      const taskListEmpty = document.getElementById('taskListEmpty');
      function loadTasks() {
        fetch('/api/tasks/client/' + clientId)
          .then(r => r.json())
          .then(tasks => {
            taskListEmpty.style.display = tasks.length ? 'none' : 'block';
            taskListEmpty.textContent = tasks.length ? '' : 'No follow-up tasks yet.';
            taskList.innerHTML = tasks.map(t => {
              const due = new Date(t.dueDate);
              const isOverdue = !t.done && due < new Date();
              return '<li class="flex items-center justify-between p-2 ' + (t.done ? 'bg-gray-50 opacity-75' : isOverdue ? 'bg-red-50' : 'bg-gray-50') + ' rounded">' +
                '<label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" ' + (t.done ? 'checked' : '') + ' data-id="' + t._id + '" class="task-toggle rounded">' +
                '<span class="' + (t.done ? 'line-through text-gray-500' : '') + '">' + (t.title || '').replace(/</g, '&lt;') + '</span>' +
                '<span class="text-xs text-gray-500">Due ' + due.toLocaleDateString() + '</span></label></li>';
            }).join('');
            taskList.querySelectorAll('.task-toggle').forEach(cb => {
              cb.addEventListener('change', function() {
                fetch('/api/tasks/' + this.dataset.id + '/toggle-done', { method: 'PATCH' })
                  .then(r => r.ok && loadTasks());
              });
            });
          })
          .catch(() => { taskListEmpty.textContent = 'Could not load tasks.'; });
      }
      loadTasks();
      document.getElementById('addTaskForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const due = fd.get('dueDate');
        if (!due) return;
        try {
          const res = await fetch('/api/tasks', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId, title: fd.get('title'), dueDate: new Date(due).toISOString() })
          });
          if (res.ok) {
            e.target.reset();
            loadTasks();
          } else {
            const err = await res.json();
            alert(err.error || 'Failed to add task');
          }
        } catch (err) { alert('Failed to add task'); }
      });

      const form = document.getElementById('addActivityForm');
      const list = document.getElementById('activityList');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const type = fd.get('type');
        const content = fd.get('content');
        if (!content.trim()) return;
        try {
          const res = await fetch('/api/clients/' + clientId + '/activities', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, content: content.trim() })
          });
          if (res.ok) {
            const activity = await res.json();
            const li = document.createElement('li');
            li.className = 'flex gap-3 border-l-2 border-indigo-200 pl-4 py-2';
            const typeClass = activity.type === 'meeting' ? 'bg-blue-100 text-blue-800' : activity.type === 'call' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
            li.innerHTML = '<span class="text-xs text-gray-500 whitespace-nowrap">' + new Date(activity.createdAt).toLocaleString() + '</span>' +
              '<span class="px-2 py-0.5 rounded text-xs font-medium ' + typeClass + '">' + activity.type + '</span>' +
              '<span class="text-gray-700">' + (activity.content || '').replace(/</g, '&lt;') + '</span>' +
              '<span class="text-gray-500 text-sm">— ' + (activity.userId && activity.userId.name ? activity.userId.name : 'You') + '</span>';
            list.insertBefore(li, list.firstChild);
            const emptyMsg = document.getElementById('activityEmpty');
            if (emptyMsg) emptyMsg.remove();
            form.reset();
          } else {
            const err = await res.json();
            alert(err.error || 'Failed to add activity');
          }
        } catch (err) {
          alert('Failed to add activity');
        }
      });
    })();
  </script>
  <%- include('../partials/footer') %>
</body>
</html>
