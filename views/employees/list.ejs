<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employees</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .table-improved tbody tr:hover { background-color: rgba(238, 242, 255, 0.8); }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/sidebar-toggle') %>
  <main class="flex-1 main-content min-h-screen md:ml-64 pt-24 md:pt-8 p-4 md:p-8">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Employees</h2>
      <a href="/employees/invite" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition">
        <i class="fas fa-envelope mr-2"></i> Invite Employee
      </a>
    </div>
    <div class="overflow-auto max-h-[70vh] bg-white rounded-lg shadow table-scroll-wrap">
      <% if (employees.length === 0) { %>
      <div class="empty-state text-center py-16 px-4">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
          <i class="fas fa-user-tie text-3xl"></i>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No employees yet</h3>
        <p class="text-gray-500 mb-6 max-w-sm mx-auto">Add your first employee to get started.</p>
<a href="/employees/invite" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition">
        <i class="fas fa-envelope mr-2"></i> Invite Employee
      </a>
      </div>
      <% } else { %>
      <table class="table-improved min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 sticky top-0 z-10 shadow-sm">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <a href="/employees<%= typeof buildQuery === 'function' ? buildQuery({ sort: 'name', order: typeof sortBy !== 'undefined' && sortBy === 'name' && sortOrder === 'asc' ? 'desc' : 'asc', page: 1 }) : '?sort=name&order=asc' %>" class="inline-flex items-center gap-1 group hover:text-indigo-600">
                Name
                <% if (typeof sortBy !== 'undefined' && sortBy === 'name') { %>
                  <i class="fas fa-sort-<%= sortOrder === 'asc' ? 'up' : 'down' %> text-indigo-600"></i>
                <% } else { %>
                  <i class="fas fa-sort text-gray-400 group-hover:text-indigo-500"></i>
                <% } %>
              </a>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% employees.forEach((emp, i) => { %>
            <tr class="<%= i % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> hover:bg-indigo-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-gray-900"><%= emp.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-900"><%= emp.email %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center space-x-2">
                  <a href="/employees/edit/<%= emp._id %>" class="inline-flex items-center justify-center w-8 h-8 rounded bg-yellow-400 text-white hover:bg-yellow-500" title="Edit">
                    <i class="fas fa-edit"></i>
                  </a>
                  <form method="POST" action="/employees/delete/<%= emp._id %>" class="inline-block">
                    <button type="submit" class="inline-flex items-center justify-center w-8 h-8 rounded bg-red-500 text-white hover:bg-red-600" title="Delete" onclick="return confirm('Are you sure you want to delete this employee?');">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                  <a href="/employees/logins/<%= emp._id %>" class="inline-flex items-center justify-center w-8 h-8 rounded bg-blue-500 text-white hover:bg-blue-600" title="Show Logins">
                    <i class="fas fa-clock"></i>
                  </a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <% if (employees.length > 0) { %>
    <!-- Pagination -->
    <div class="mt-6 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Showing <span class="font-medium"><%= (pagination.page - 1) * 20 + 1 %></span> to 
        <span class="font-medium"><%= Math.min(pagination.page * 20, pagination.totalEmployees) %></span> of 
        <span class="font-medium"><%= pagination.totalEmployees %></span> employees
      </div>
      <div class="flex space-x-2">
        <% if (pagination.hasPrevPage) { %>
          <a href="/employees<%= typeof buildQuery === 'function' ? buildQuery({ page: pagination.page - 1 }) : '?page=' + (pagination.page - 1) %>" 
             class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <i class="fas fa-chevron-left mr-2"></i> Previous
          </a>
        <% } %>
        
        <% if (pagination.hasNextPage) { %>
          <a href="/employees<%= typeof buildQuery === 'function' ? buildQuery({ page: pagination.page + 1 }) : '?page=' + (pagination.page + 1) %>" 
             class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            Next <i class="fas fa-chevron-right ml-2"></i>
          </a>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
