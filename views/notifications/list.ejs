<%- include('../partials/layout-start') %>
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Notifications</h1>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
        <button type="button" id="markAllReadBtn" class="inline-flex items-center px-4 py-2 text-sm font-medium text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50 rounded-md transition">
          <i class="fas fa-check-double mr-2"></i> Mark all as read
        </button>
        <% } %>
      </div>

      <% if (notifications.length === 0) { %>
      <div class="bg-white rounded-lg shadow p-12 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-100 text-gray-400 mb-4">
          <i class="fas fa-bell-slash text-3xl"></i>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No notifications yet</h3>
        <p class="text-gray-500">When you get client assignments or meeting reminders, they will appear here.</p>
      </div>
      <% } else { %>
      <ul id="notificationList" class="space-y-2">
        <% notifications.forEach(function(n) { %>
        <li class="notification-item bg-white rounded-lg shadow border border-gray-100 overflow-hidden <%= n.read ? 'opacity-75' : 'border-l-4 border-l-indigo-500' %>" data-id="<%= n._id %>">
          <a href="<%= n.link || '#' %>" class="block p-4 hover:bg-gray-50 transition <%= n.read ? '' : 'font-medium' %>" data-mark-read>
            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-0.5 w-10 h-10 rounded-full flex items-center justify-center <%= n.type === 'client_assigned' || n.type === 'client_bulk_assigned' ? 'bg-indigo-100 text-indigo-600' : n.type === 'meeting_reminder' ? 'bg-amber-100 text-amber-600' : 'bg-gray-100 text-gray-600' %>">
                <% if (n.type === 'client_assigned' || n.type === 'client_bulk_assigned') { %>
                  <i class="fas fa-user-plus"></i>
                <% } else if (n.type === 'meeting_reminder') { %>
                  <i class="fas fa-calendar-day"></i>
                <% } else if (n.type === 'client_added') { %>
                  <i class="fas fa-user-plus"></i>
                <% } else { %>
                  <i class="fas fa-bell"></i>
                <% } %>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-gray-900"><%= n.title %></p>
                <p class="text-sm text-gray-600 mt-0.5"><%= n.message %></p>
                <p class="text-xs text-gray-400 mt-2"><%= new Date(n.createdAt).toLocaleString() %></p>
              </div>
              <% if (!n.read) { %>
              <span class="flex-shrink-0 w-2 h-2 rounded-full bg-indigo-500 mt-2"></span>
              <% } %>
            </div>
          </a>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </main>
  <script>
  (function() {
    function csrfHeader() { var m = document.querySelector('meta[name="csrf-token"]'); return m ? m.getAttribute('content') : ''; }
    document.querySelectorAll('[data-mark-read]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var href = this.getAttribute('href');
        if (!href || href === '#') return;
        var li = this.closest('.notification-item');
        var id = li && li.dataset.id;
        if (id && !li.classList.contains('read-done')) {
          e.preventDefault();
          fetch('/notifications/' + id + '/read', { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfHeader() } })
            .then(function(r) { return r.json(); })
            .then(function() {
              if (li) {
                li.classList.add('opacity-75', 'read-done');
                li.classList.remove('border-l-indigo-500');
                var fm = li.querySelector('.font-medium');
                if (fm) fm.classList.remove('font-medium');
                var dot = li.querySelector('.bg-indigo-500.rounded-full');
                if (dot) dot.remove();
              }
              window.location.href = href;
            })
            .catch(function() { window.location.href = href; });
        }
      });
    });
    var markAllBtn = document.getElementById('markAllReadBtn');
    if (markAllBtn) {
      markAllBtn.addEventListener('click', function() {
        fetch('/notifications/mark-all-read', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfHeader() } })
          .then(function(r) { return r.json(); })
          .then(function() { window.location.reload(); });
      });
    }
  })();
  </script>
<%- include('../partials/layout-end') %>
