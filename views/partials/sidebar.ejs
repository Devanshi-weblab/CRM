<%- include('loader') %>
<%- include('toast') %>
<% const isAdmin = user && user.role === 'admin'; %>
<aside id="sidebar" class="sidebar fixed left-0 top-0 h-full shadow-lg z-40 flex flex-col transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-in-out w-64 bg-white">
  <div class="sidebar-header flex items-center justify-between p-4 border-b border-gray-200 flex-shrink-0">
    <a href="<%= isAdmin ? '/dashboard/admin' : '/dashboard/employee' %>" class="sidebar-brand flex items-center min-w-0 flex-1 min-w-0" title="<%= isAdmin ? 'CRM Admin' : 'CRM Employee' %>">
      <i class="fas fa-chart-line text-xl text-indigo-600 flex-shrink-0 sidebar-brand-icon"></i>
      <span class="sidebar-text ml-3 text-xl font-bold text-indigo-600 hover:text-indigo-700 truncate">CRM <%= isAdmin ? 'Admin' : 'Employee' %></span>
    </a>
    <button type="button" id="sidebarCollapseBtn" class="hidden md:flex items-center justify-center w-8 h-8 rounded-md text-gray-500 hover:bg-gray-100 hover:text-indigo-600 flex-shrink-0 ml-1" aria-label="Toggle sidebar">
      <i class="fas fa-chevron-left sidebar-expand-icon"></i>
      <i class="fas fa-chevron-right sidebar-collapse-icon hidden"></i>
    </button>
  </div>
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto overflow-x-hidden">
    <a href="<%= isAdmin ? '/dashboard/admin' : '/dashboard/employee' %>" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Dashboard">
      <i class="fas fa-home w-5 h-5 flex-shrink-0"></i>
      <span class="sidebar-text ml-3 truncate">Dashboard</span>
    </a>
    <a href="/notifications" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium relative" title="Notifications">
      <i class="fas fa-bell w-5 h-5 flex-shrink-0"></i>
      <span class="sidebar-text ml-3 truncate">Notifications</span>
      <% if (typeof notificationUnreadCount !== 'undefined' && notificationUnreadCount > 0) { %>
      <span class="notification-badge absolute top-2 right-2 md:top-3 md:right-3 min-w-[1.25rem] h-5 px-1 flex items-center justify-center text-xs font-bold text-white bg-red-500 rounded-full"><%= notificationUnreadCount > 99 ? '99+' : notificationUnreadCount %></span>
      <% } %>
    </a>
    <a href="/clients" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Clients">
      <i class="fas fa-users w-5 h-5 flex-shrink-0"></i>
      <span class="sidebar-text ml-3 truncate">Clients</span>
    </a>
    <% if (isAdmin) { %>
      <a href="/employees" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Employees">
        <i class="fas fa-user-tie w-5 h-5 flex-shrink-0"></i>
        <span class="sidebar-text ml-3 truncate">Employees</span>
      </a>
      <a href="/employees/invite" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Invite Employee">
        <i class="fas fa-envelope w-5 h-5 flex-shrink-0"></i>
        <span class="sidebar-text ml-3 truncate">Invite Employee</span>
      </a>
      <a href="/admin/meetings" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Meeting Calendar">
        <i class="fas fa-calendar-alt w-5 h-5 flex-shrink-0"></i>
        <span class="sidebar-text ml-3 truncate">Meeting Calendar</span>
      </a>
      <a href="/admin/status-options" class="sidebar-link flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Status Options">
        <i class="fas fa-tags w-5 h-5 flex-shrink-0"></i>
        <span class="sidebar-text ml-3 truncate">Status Options</span>
      </a>
    <% } %>
  </nav>
  <div class="sidebar-footer p-3 border-t border-gray-200 space-y-1 flex-shrink-0">
    <span class="sidebar-text block px-4 py-2 text-sm text-gray-600 truncate"><%= user ? user.name : '' %></span>
    <a href="/profile" class="flex items-center px-4 py-3 text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 rounded-md font-medium" title="Profile">
      <i class="fas fa-user w-5 h-5 flex-shrink-0"></i>
      <span class="sidebar-text ml-3 truncate">Profile</span>
    </a>
    <a href="/auth/logout" class="flex items-center px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 rounded-md font-medium" title="Logout">
      <i class="fas fa-sign-out-alt w-5 h-5 flex-shrink-0"></i>
      <span class="sidebar-text ml-3 truncate">Logout</span>
    </a>
  </div>
</aside>
<div id="sidebar-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-30 md:hidden hidden" aria-hidden="true"></div>
<style>
  .main-content { transition: margin-left 0.3s ease; }
  /* Mobile: show sidebar when menu is open */
  body.sidebar-open #sidebar { transform: translateX(0); }
  body.sidebar-open #sidebar-overlay { display: block !important; }
  /* Desktop: collapsed state - narrow, icons only, darker color */
  body.sidebar-collapsed #sidebar {
    width: 5rem;
    background-color: #1e3a5f;
  }
  body.sidebar-collapsed #sidebar .sidebar-text,
  body.sidebar-collapsed #sidebar .sidebar-brand .sidebar-text {
    display: none;
  }
  body.sidebar-collapsed #sidebar .sidebar-header,
  body.sidebar-collapsed #sidebar .sidebar-footer,
  body.sidebar-collapsed #sidebar nav a {
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  body.sidebar-collapsed #sidebar .sidebar-brand { justify-content: center; margin-left: 0; }
  body.sidebar-collapsed #sidebar .sidebar-header .sidebar-brand .sidebar-text { display: none; }
  body.sidebar-collapsed #sidebar .sidebar-brand i.sidebar-brand-icon { margin-left: 0; color: #a5b4fc; }
  body.sidebar-collapsed #sidebar .sidebar-header {
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
  }
  body.sidebar-collapsed #sidebar .sidebar-header #sidebarCollapseBtn { margin-left: 0; }
  body.sidebar-collapsed #sidebar nav a,
  body.sidebar-collapsed #sidebar .sidebar-footer a,
  body.sidebar-collapsed #sidebar .sidebar-footer span {
    color: #e2e8f0;
  }
  body.sidebar-collapsed #sidebar nav a:hover,
  body.sidebar-collapsed #sidebar .sidebar-footer a:hover {
    background-color: rgba(255,255,255,0.1);
    color: #fff;
  }
  body.sidebar-collapsed #sidebar .sidebar-footer span.sidebar-text { display: none; }
  body.sidebar-collapsed #sidebar .sidebar-footer a .sidebar-text { display: none; }
  body.sidebar-collapsed #sidebar .sidebar-header { border-color: rgba(255,255,255,0.1); }
  body.sidebar-collapsed #sidebar .sidebar-footer { border-color: rgba(255,255,255,0.1); }
  body.sidebar-collapsed #sidebar .sidebar-link.bg-indigo-50 { background-color: rgba(255,255,255,0.15); color: #fff; }
  body.sidebar-collapsed #sidebar #sidebarCollapseBtn { color: #e2e8f0; }
  body.sidebar-collapsed #sidebar #sidebarCollapseBtn:hover { background-color: rgba(255,255,255,0.1); color: #fff; }
  body.sidebar-collapsed #sidebar .sidebar-expand-icon { display: none; }
  body.sidebar-collapsed #sidebar .sidebar-collapse-icon { display: inline-block !important; }
  body.sidebar-collapsed .main-content { margin-left: 5rem !important; }
</style>
